# Production on Vercel needs no variables here: the browser calls the same origin (/api/...),
# and server-side calls use BACKEND_URL, which Vercel injects through the service binding.
# Only set these when the API lives on a different origin than the web app:
# PUBLIC_API_BASE_URL=https://api.example.com
# Local development: leave everything unset (Vite proxies /api to http://localhost:8000).
